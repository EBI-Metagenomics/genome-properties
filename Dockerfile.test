FROM perl:5.40-slim

RUN apt-get update \
    && apt-get install --yes --no-install-recommends build-essential \
    && cpanm --notest \
      Clone \
      Data::Printer \
      File::Slurp \
      JSON \
      LWP::UserAgent \
      Try::Tiny \
    && apt-get purge --yes --auto-remove build-essential \
    && rm -rf /root/.cpanm /var/lib/apt/lists/*

WORKDIR /workspace

COPY code/modules code/modules
COPY code/tests code/tests

CMD ["prove", "-Icode/modules", "-r", "code/tests/t"]
